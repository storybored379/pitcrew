# Copy to .env in the checkout. No credentials belong here.
# Set these to `id -u` / `id -g` for the account that ran pitcrew init.
PITCREW_UID=1000
PITCREW_GID=1000
# Absolute host directory created by `pitcrew init --output runtime`.
PITCREW_HOME=/srv/pitcrew/runtime
# Local build by default. A published image can be selected by digest later.
PITCREW_IMAGE=pitcrew-stack:local
# Healthcheck ports must match pitcrew.toml if you change listener addresses.
PITCREW_CONTROL_PORT=7400
PITCREW_WEB_PORT=7401
PITCREW_ADMIN_PORT=7402
PITCREW_AGENT_PORT=8790
