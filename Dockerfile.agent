FROM rust:1.99.1-bookworm AS build
WORKDIR /build
COPY . .
RUN cargo build --locked --release --bin pitcrew-agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tzdata ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/target/release/pitcrew-agent /usr/local/bin/pitcrew-agent
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD test "$(curl --noproxy '*' --silent --max-time 4 --output /dev/null --write-out '%{http_code}' http://127.0.0.1:8790/v1/health)" = 401 || exit 1
ENTRYPOINT ["/usr/local/bin/pitcrew-agent"]
CMD ["--config", "/etc/pitcrew/agent.toml"]
