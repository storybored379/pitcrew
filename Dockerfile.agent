FROM rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS build
ARG CARGO_BUILD_JOBS=3
WORKDIR /build
COPY . .
RUN cargo build --locked --release --bin pitcrew-agent

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
COPY packaging/debian.sources /etc/apt/sources.list.d/debian.sources
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tzdata ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/target/release/pitcrew-agent /usr/local/bin/pitcrew-agent
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD test "$(curl --noproxy '*' --silent --max-time 4 --output /dev/null --write-out '%{http_code}' http://127.0.0.1:8790/v1/health)" = 401 || exit 1
ENTRYPOINT ["/usr/local/bin/pitcrew-agent"]
CMD ["--config", "/etc/pitcrew/agent.toml"]
