{
  "version": 1,
  "id": "domain-budget-reserved-on-retry",
  "adapter": "domain",
  "description": "Every attempt consumes its reservation even after an ambiguous request proves absent; exhaustion fails exactly once.",
  "initial": {
    "id": 1,
    "library": 2,
    "original": {
      "id": 3,
      "revision": 1
    },
    "constraints": {
      "language": "eng",
      "require_sdr": true
    },
    "policy": {
      "max_grabs": 2,
      "stage_timeout": 20,
      "total_timeout": 200
    },
    "now": 0
  },
  "steps": [
    {
      "at": 1,
      "event": {
        "SelectRelease": {
          "release": 4,
          "access": {
            "Granted": {
              "library": 2,
              "expires_at": 100
            }
          }
        }
      },
      "state": "GrabIntent",
      "effects": [
        "Grab"
      ],
      "reserved_budget": 1,
      "active_grabs": 1,
      "rejected": false
    },
    {
      "at": 2,
      "event": {
        "Observed": {
          "intent": {
            "job": 1,
            "sequence": 1
          },
          "observation": "GrabAmbiguous"
        }
      },
      "state": "GrabReconciling",
      "effects": [
        "ReconcileGrab"
      ],
      "reserved_budget": 1,
      "active_grabs": 1,
      "rejected": false
    },
    {
      "at": 3,
      "event": {
        "Observed": {
          "intent": {
            "job": 1,
            "sequence": 2
          },
          "observation": {
            "GrabReconciled": "Absent"
          }
        }
      },
      "state": "Rejected",
      "effects": [],
      "reserved_budget": 1,
      "active_grabs": 0,
      "rejected": false
    },
    {
      "at": 4,
      "event": {
        "SelectRelease": {
          "release": 8,
          "access": {
            "Granted": {
              "library": 2,
              "expires_at": 100
            }
          }
        }
      },
      "state": "GrabIntent",
      "effects": [
        "Grab"
      ],
      "reserved_budget": 2,
      "active_grabs": 1,
      "rejected": false
    },
    {
      "at": 5,
      "event": {
        "Observed": {
          "intent": {
            "job": 1,
            "sequence": 1
          },
          "observation": {
            "GrabAccepted": {
              "download": 5
            }
          }
        }
      },
      "state": "GrabIntent",
      "effects": [],
      "reserved_budget": 2,
      "active_grabs": 1,
      "rejected": true
    },
    {
      "at": 6,
      "event": {
        "Observed": {
          "intent": {
            "job": 1,
            "sequence": 3
          },
          "observation": "GrabAmbiguous"
        }
      },
      "state": "GrabReconciling",
      "effects": [
        "ReconcileGrab"
      ],
      "reserved_budget": 2,
      "active_grabs": 1,
      "rejected": false
    },
    {
      "at": 7,
      "event": {
        "Observed": {
          "intent": {
            "job": 1,
            "sequence": 4
          },
          "observation": {
            "GrabReconciled": "Absent"
          }
        }
      },
      "state": "Rejected",
      "effects": [],
      "reserved_budget": 2,
      "active_grabs": 0,
      "rejected": false
    },
    {
      "at": 8,
      "event": {
        "SelectRelease": {
          "release": 9,
          "access": {
            "Granted": {
              "library": 2,
              "expires_at": 100
            }
          }
        }
      },
      "state": "Failed",
      "effects": [
        "NotifyAdmin",
        "NotifyViewerFailure"
      ],
      "reserved_budget": 2,
      "active_grabs": 0,
      "rejected": false
    },
    {
      "at": 9,
      "event": "Tick",
      "state": "Failed",
      "effects": [],
      "reserved_budget": 2,
      "active_grabs": 0,
      "rejected": true
    }
  ]
}
