{
  "version": 1,
  "id": "domain-exclusion-storage-identities",
  "adapter": "domain",
  "description": "GUID, torrent infohash, and client-scoped download identity each exclude a renamed failed release.",
  "initial": {
    "id": 1,
    "library": 7,
    "original": {
      "id": 10,
      "revision": 1
    },
    "constraints": {
      "language": null,
      "require_sdr": false
    },
    "policy": {
      "max_grabs": 3,
      "stage_timeout": 10,
      "total_timeout": 100
    },
    "now": 0
  },
  "steps": [
    {
      "at": 1,
      "event": {
        "SelectCandidate": {
          "candidate": {
            "release": 40,
            "identity": {
              "guid": {
                "source": "indexer-a",
                "value": "release-a"
              },
              "infohash": "abc123",
              "download": {
                "client_id": "client-a",
                "download_id": "download-a"
              }
            },
            "quality": "SameOrBetter"
          },
          "access": {
            "Granted": {
              "library": 7,
              "expires_at": 1000
            }
          }
        }
      },
      "state": "GrabIntent",
      "effects": [
        "Grab"
      ],
      "effect_payloads": [
        {
          "Grab": {
            "release": 40,
            "reservation": 1
          }
        }
      ],
      "reserved_budget": 1,
      "active_grabs": 1
    },
    {
      "at": 2,
      "event": {
        "DownloadFailed": {
          "grab": {
            "job": 1,
            "sequence": 1
          },
          "download": 50
        }
      },
      "state": "Rejected",
      "effects": [],
      "effect_payloads": [],
      "reserved_budget": 1,
      "active_grabs": 0
    },
    {
      "at": 2,
      "event": {
        "SelectCandidate": {
          "candidate": {
            "release": 41,
            "identity": {
              "guid": {
                "source": "indexer-a",
                "value": "release-a"
              },
              "infohash": null,
              "download": null
            },
            "quality": "SameOrBetter"
          },
          "access": {
            "Granted": {
              "library": 7,
              "expires_at": 1000
            }
          }
        }
      },
      "state": "Rejected",
      "effects": [],
      "effect_payloads": [],
      "reserved_budget": 1,
      "active_grabs": 0,
      "rejected": true
    },
    {
      "at": 2,
      "event": {
        "SelectCandidate": {
          "candidate": {
            "release": 41,
            "identity": {
              "guid": null,
              "infohash": "abc123",
              "download": null
            },
            "quality": "SameOrBetter"
          },
          "access": {
            "Granted": {
              "library": 7,
              "expires_at": 1000
            }
          }
        }
      },
      "state": "Rejected",
      "effects": [],
      "effect_payloads": [],
      "reserved_budget": 1,
      "active_grabs": 0,
      "rejected": true
    },
    {
      "at": 2,
      "event": {
        "SelectCandidate": {
          "candidate": {
            "release": 41,
            "identity": {
              "guid": null,
              "infohash": null,
              "download": {
                "client_id": "client-a",
                "download_id": "download-a"
              }
            },
            "quality": "SameOrBetter"
          },
          "access": {
            "Granted": {
              "library": 7,
              "expires_at": 1000
            }
          }
        }
      },
      "state": "Rejected",
      "effects": [],
      "effect_payloads": [],
      "reserved_budget": 1,
      "active_grabs": 0,
      "rejected": true
    },
    {
      "at": 3,
      "event": {
        "SelectRelease": {
          "release": 42,
          "access": {
            "Granted": {
              "library": 7,
              "expires_at": 1000
            }
          }
        }
      },
      "state": "GrabIntent",
      "effects": [
        "Grab"
      ],
      "effect_payloads": [
        {
          "Grab": {
            "release": 42,
            "reservation": 2
          }
        }
      ],
      "reserved_budget": 2,
      "active_grabs": 1
    }
  ]
}
