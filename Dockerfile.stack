FROM rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS build
ARG CARGO_BUILD_JOBS=3
WORKDIR /build
COPY . .
RUN cargo build --locked --release -p pitcrew -p pitcrew-web -p pitcrew-bot -p pitcrew-admin

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
COPY packaging/debian.sources /etc/apt/sources.list.d/debian.sources
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 pitcrew \
    && useradd --uid 10001 --gid 10001 --no-create-home pitcrew \
    && install -d -o pitcrew -g pitcrew -m 0700 /var/lib/pitcrew
COPY --from=build /build/target/release/pitcrew /build/target/release/pitcrew-web /build/target/release/pitcrew-bot /build/target/release/pitcrew-admin /usr/local/bin/
USER 10001:10001
WORKDIR /
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl --noproxy '*' --fail --silent --max-time 4 http://127.0.0.1:7400/healthz || exit 1
CMD ["pitcrew", "--config", "/config/pitcrew.toml"]
